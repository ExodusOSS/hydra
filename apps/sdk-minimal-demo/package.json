{
  "name": "@exodus/sdk-minimal-demo",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Minimal demo for Exodus SDK",
  "author": "Exodus Movement, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/apps/sdk-minimal-demo",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Asdk-minimal-demo"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "!**/__tests__/**",
    "!**/*.test.js"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "clean": "pnpm exec tsc --build --clean tsconfig.build.json",
    "watch": "pnpm exec tsc --watch tsconfig.build.json",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm run lint --fix",
    "test:integration": "pnpm exec exodus-test --jest --esbuild=.ts --forceExit",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@exodus/basic-utils": "workspace:^",
    "@exodus/deferring-storage": "workspace:^",
    "@exodus/ethereum-plugin": "^3.1.1",
    "@exodus/event-log": "workspace:^",
    "@exodus/fusion-local": "workspace:^",
    "@exodus/headless": "workspace:^",
    "@exodus/logger": "workspace:^",
    "@exodus/prettier": "workspace:^",
    "@exodus/storage-memory": "workspace:^",
    "@exodus/sync-time": "workspace:^",
    "@exodus/transform-storage": "workspace:^",
    "@exodus/wild-emitter": "workspace:^",
    "buffer-json": "^2.0.0"
  },
  "devDependencies": {
    "@exodus/domain-serialization": "workspace:^",
    "@exodus/models": "workspace:^",
    "@exodus/sdk-rpc": "workspace:^",
    "@exodus/storage-interface": "workspace:^",
    "@types/buffer-json": "^2.0.1",
    "eventemitter3": "^4.0.7"
  }
}
