{
  "license": "MIT",
  "version": "2.16.2",
  "author": "Exodus Movement, Inc.",
  "name": "@exodus/nfts-proxy",
  "description": "Client for the NFTs proxy server (https://nfts-proxy.exodus.io)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "scripts": {
    "lint": "pnpm exec eslint .",
    "test": "pnpm exec exodus-test --jest --esbuild",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "build": "rm -rf ../../.cache/nfts-proxy lib && pnpm exec tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm -w run build --scope @exodus/nfts-proxy"
  },
  "dependencies": {
    "@exodus/fetch": "^1.3.0"
  },
  "gitHead": "f36e3a0f8a6b6461f310b81042e572fedf13c932",
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/libraries/nfts-proxy",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Anfts-proxy"
  }
}
