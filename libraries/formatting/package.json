{
  "name": "@exodus/formatting",
  "type": "module",
  "version": "11.1.1",
  "description": "Utils for formatting numbers, strings and money.",
  "author": "Exodus Movement, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/libraries/formatting",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Aformatting"
  },
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*.js",
    "./lib/*.js": "./lib/*.js"
  },
  "main": "lib/index.js",
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "build:watch": "pnpm exec tsc -w -p tsconfig.build.json",
    "clean": "pnpm exec tsc --build --clean",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm run lint --fix",
    "test": "pnpm exec exodus-test --jest --esbuild",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm -w run build --scope @exodus/formatting"
  },
  "dependencies": {
    "@exodus/currency": "workspace:^",
    "@exodus/fiat-currencies": "workspace:^",
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
