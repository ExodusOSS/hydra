{
  "name": "@exodus/bip322-js",
  "version": "3.2.5",
  "description": "A Javascript library that provides utility functions related to the BIP-322 signature scheme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "!**/__tests__/**"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "lint": "pnpm exec eslint",
    "lint:fix": "pnpm run lint --fix",
    "doc": "typedoc src/index.ts",
    "test": "pnpm exec exodus-test --jest --esbuild",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm -w run build --scope @exodus/bip322-js"
  },
  "keywords": [
    "bip322",
    "bitcoinjs",
    "javascript",
    "typescript",
    "no-WASM"
  ],
  "author": "Exodus Movement, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/minimalistic-assert": "^1.0.1",
    "@types/node": "^22.7.4",
    "ecpair": "^2.0.1",
    "typedoc": "^0.24.8",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "@exodus/asset-types": "^0.5.0",
    "@exodus/bitcoinjs": "^2.0.0",
    "@exodus/bytes": "^1.0.0-rc.8",
    "@exodus/crypto": "^1.0.0-rc.26",
    "@noble/curves": "^2.0.1",
    "bech32": "^1.1.3",
    "minimalistic-assert": "^1.0.1",
    "varuint-bitcoin": "^1.0.1"
  },
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/libraries/bip322-js",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Abip322-js"
  }
}
