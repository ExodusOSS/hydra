{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "rootDir": "./src",
    "skipLibCheck": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strictNullChecks": true,
    "esModuleInterop": true,
