{
  "name": "@exodus/deferring-storage",
  "type": "module",
  "version": "1.0.2",
  "description": "Storage that defers access besides clearing or deleting until it is released",
  "author": "Exodus Movement, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/libraries/deferring-storage",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Adeferring-storage"
  },
  "main": "lib/index.js",
  "exports": "./lib/index.js",
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "clean": "pnpm exec tsc --build --clean",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm run lint --fix",
    "test": "pnpm exec exodus-test --jest --esbuild",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm -w run build --scope @exodus/deferring-storage"
  },
  "dependencies": {
    "@exodus/storage-interface": "^1.0.0",
    "p-defer": "^4.0.0"
  },
  "publishConfig": {
    "provenance": false
  }
}
