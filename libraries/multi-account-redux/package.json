{
  "name": "@exodus/multi-account-redux",
  "version": "3.0.1",
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/libraries/multi-account-redux",
  "license": "MIT",
  "author": "Exodus Movement, Inc.",
  "description": "Util for redux slices that store data per-asset per-walletAccount",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Amulti-account-redux"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "clean": "pnpm exec tsc --build --clean",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm run lint --fix",
    "test": "pnpm exec exodus-test --jest --esbuild",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm -w run build --scope @exodus/multi-account-redux"
  },
  "dependencies": {
    "@exodus/basic-utils": "workspace:^",
    "@exodus/models": "workspace:^",
    "@exodus/redux-dependency-injection": "workspace:^",
    "reselect": "^3.0.1"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@exodus/assets": "^11.0.0",
    "@exodus/assets-base": "^12.0.0",
    "@exodus/assets-feature": "workspace:^",
    "@exodus/wallet-accounts": "workspace:^",
    "redux": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
