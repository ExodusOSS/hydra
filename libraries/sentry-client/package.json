{
  "name": "@exodus/sentry-client",
  "version": "6.5.0",
  "description": "API client for sanitizing and sending errors to Sentry.io",
  "author": "Exodus Movement, Inc.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/libraries/sentry-client",
  "license": "MIT",
  "keywords": [
    "sentry",
    "error-tracking",
    "monitoring",
    "logging"
  ],
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Asentry-client"
  },
  "main": "lib/index.js",
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm run lint --fix",
    "test": "pnpm exec exodus-test --esbuild --jest",
    "test:integration": "RUN_TESTS=integration pnpm run test",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm -w run build --scope @exodus/sentry-client"
  },
  "devDependencies": {
    "@exodus/basic-utils": "workspace:^",
    "@exodus/safe-string": "workspace:^",
    "@exodus/traceparent": "workspace:^"
  },
  "dependencies": {
    "@exodus/crypto": "^1.0.0-rc.16",
    "@exodus/errors": "^3.4.0",
    "@exodus/typeforce": "^1.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
