{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": ".",
    "skipLibCheck": true,
    "outDir": "./lib",
    "noEmit": true,
    "strict": true,
    "lib": ["esnext"],
    "target": "es2022",
    "types": ["node", "jest"]
  },
  "include": ["src", "__tests__"],
  "exclude": ["lib"]
}
