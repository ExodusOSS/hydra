{
  "name": "@exodus/redux-dependency-injection",
  "version": "5.0.0",
  "type": "module",
  "description": "Dependency-injection container for redux modules",
  "author": "Exodus Movement, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/libraries/redux-dependency-injection",
  "license": "MIT",
