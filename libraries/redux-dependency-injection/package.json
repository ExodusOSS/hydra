    "@exodus/logger": "^1.2.2",
    "@exodus/typeforce": "^1.18.0",
    "lodash": "^4.17.11",
    "reselect": "^3.0.1"
  },
  "peerDependencies": {
    "redux": "^4.0.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.24",
