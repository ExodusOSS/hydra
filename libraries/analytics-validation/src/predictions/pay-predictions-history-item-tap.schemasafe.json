{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event": {
      "const": "PayPredictionsHistoryItemTap"
    },
    "properties": {
      "allOf": [
        {
          "$ref": "common-properties#"
        },
        {
          "$ref": "common-properties#/definitions/predictionsProperties"
        }
      ],
      "type": "object",
      "required": [],
      "properties": {
        "position_id": {
          "type": "string",
          "format": "any-string"
        },
        "market_id": {
          "type": "string",
          "format": "any-string"
        },
        "position_status": {
          "enum": ["active", "won", "lost", "void"]
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false,
  "required": ["event", "properties"]
}
