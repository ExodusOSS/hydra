{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event": {
      "const": "PayPredictionsWithdrawFail"
    },
    "properties": {
      "allOf": [
        {
          "$ref": "common-properties#"
        },
        {
          "$ref": "common-properties#/definitions/predictionsProperties"
        }
      ],
      "type": "object",
      "required": [],
      "properties": {
        "failure_reason": {
          "enum": [
            "provider_error",
            "network",
            "already_in_progress",
            "quote_unavailable",
            "user_cancelled",
            "other"
          ]
        },
        "amount_usd": {
          "type": "number",
          "minimum": 0
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false,
  "required": ["event", "properties"]
}
