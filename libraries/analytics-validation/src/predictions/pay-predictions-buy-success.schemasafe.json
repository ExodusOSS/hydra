{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event": {
      "const": "PayPredictionsBuySuccess"
    },
    "properties": {
      "allOf": [
        {
          "$ref": "common-properties#"
        },
        {
          "$ref": "common-properties#/definitions/predictionsProperties"
        }
      ],
      "type": "object",
      "required": [],
      "properties": {
        "market_id": {
          "type": "string",
          "format": "any-string"
        },
        "option_id": {
          "type": "string",
          "format": "any-string"
        },
        "position_id": {
          "type": "string",
          "format": "any-string"
        },
        "amount_usd": {
          "type": "number",
          "minimum": 0
        },
        "fee_usd": {
          "type": "number",
          "minimum": 0
        },
        "builder_fee_usd": {
          "type": "number",
          "minimum": 0
        },
        "platform_fee_usd": {
          "type": "number",
          "minimum": 0
        },
        "reward_pct": {
          "type": "number",
          "minimum": 0
        },
        "expected_payout_usd": {
          "type": "number",
          "minimum": 0
        },
        "is_first_buy": {
          "type": "boolean"
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false,
  "required": ["event", "properties"]
}
