{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event": {
      "const": "PayPredictionsFundSuccess"
    },
    "properties": {
      "allOf": [
        {
          "$ref": "common-properties#"
        },
        {
          "$ref": "common-properties#/definitions/predictionsProperties"
        }
      ],
      "type": "object",
      "required": [],
      "properties": {
        "amount_usd": {
          "type": "number",
          "minimum": 0
        },
        "fee_usd": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "enum": ["empty_state", "insufficient_funds", "proactive_top_up"]
        },
        "is_first_fund": {
          "type": "boolean"
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false,
  "required": ["event", "properties"]
}
