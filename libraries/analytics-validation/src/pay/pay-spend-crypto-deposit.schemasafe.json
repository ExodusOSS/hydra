{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event": {
      "const": "PaySpendCryptoDeposit"
    },
    "properties": {
      "allOf": [
        {
          "$ref": "common-properties#"
        }
      ],
      "type": "object",
      "required": ["asset", "amount", "amount_usd"],
      "properties": {
        "asset": {
          "enum": ["cbBTC", "cbETH", "cbXRP"]
        },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Quoted wrapped-asset amount to receive when the confirmed conversion starts."
        },
        "amount_usd": {
          "type": "number",
          "minimum": 0,
          "description": "USD value of the quoted wrapped-asset amount, excluding the separate activation gas swap."
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false,
  "required": ["event", "properties"]
}
