{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event": {
      "const": "PayOnboardingComplete"
    },
    "properties": {
      "allOf": [
        {
          "$ref": "common-properties#"
        }
      ],
      "type": "object",
      "required": [],
      "properties": {
        "invite_code": {
          "type": ["number", "null"]
        },
        "origin": {
          "type": "string",
          "enum": [
            "default-region",
            "invite-code",
            "xo-cash",
            "wallet-banner",
            "classic-wallet-menu",
            "spend-card-promo"
          ]
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false,
  "required": ["event", "properties"]
}
