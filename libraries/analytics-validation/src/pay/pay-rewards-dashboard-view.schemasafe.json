{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event": {
      "const": "PayRewardsDashboardView"
    },
    "properties": {
      "allOf": [
        {
          "$ref": "common-properties#"
        }
      ],
      "type": "object",
      "required": [],
      "properties": {
        "entry_point": {
          "type": "string",
          "enum": [
            "pay_home_card",
            "wallet_banner",
            "onboarding",
            "settings",
            "profile",
            "cash_banner",
            "dashboard_info",
            "disable_sheet",
            "send_invitation",
            "swap_fee"
          ]
        },
        "points_total": {
          "type": "number"
        },
        "points_pending": {
          "type": "number"
        },
        "welcome_bonus_points": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "can_redeem": {
          "type": "boolean"
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false,
  "required": ["event", "properties"]
}
