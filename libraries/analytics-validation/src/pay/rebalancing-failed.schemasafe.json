{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event": { "const": "RebalancingFailed" },
    "properties": {
      "allOf": [{ "$ref": "common-properties#" }],
      "type": "object",
      "required": [
        "source_asset",
        "target_asset",
        "amount_usd",
        "attempt_number",
        "duration_ms",
        "failure_reason_type",
        "retry_backoff_ms"
      ],
      "properties": {
        "source_asset": { "type": "string", "format": "any-string" },
        "target_asset": { "type": "string", "format": "any-string" },
        "amount_usd": { "type": "number", "exclusiveMinimum": 0 },
        "attempt_number": { "type": "integer", "minimum": 1 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "failure_reason_type": {
          "enum": ["create_deposit_transaction", "transfer", "broadcast", "broadcast_unconfirmed"]
        },
        "retry_backoff_ms": { "type": "integer", "minimum": 0 },
        "error_type": {
          "enum": [
            "wallet_locked",
            "timeout",
            "network_error",
            "rate_limited",
            "rewards_not_joined",
            "phone_verification_required",
            "asset_disabled",
            "service_unavailable",
            "server_error",
            "request_rejected",
            "simulation_failed",
            "insufficient_gas",
            "insufficient_balance",
            "nonce_conflict",
            "chain_rpc_error",
            "broadcast_rejected",
            "unknown"
          ]
        },
        "pay_order_id": {
          "type": "string",
          "pattern": "^[0-9a-z]{20,32}$"
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false,
  "required": ["event", "properties"]
}
