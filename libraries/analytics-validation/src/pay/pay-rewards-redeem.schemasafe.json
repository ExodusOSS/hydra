{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event": {
      "const": "PayRewardsRedeem"
    },
    "properties": {
      "allOf": [
        {
          "$ref": "common-properties#"
        }
      ],
      "type": "object",
      "required": [],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "points": {
          "type": ["number", "null"]
        },
        "amount_usd": {
          "type": ["number", "null"]
        },
        "error_type": {
          "type": ["string", "null"],
          "enum": ["insufficient_points", "conversion_disabled", "network", "other", null]
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false,
  "required": ["event", "properties"]
}
