{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event": {
      "const": "PayRewardsDashboardTabView"
    },
    "properties": {
      "allOf": [
        {
          "$ref": "common-properties#"
        }
      ],
      "type": "object",
      "required": [],
      "properties": {
        "tab": {
          "type": "string",
          "enum": ["points", "store", "benefits"]
        },
        "entry_point": {
          "type": "string",
          "enum": [
            "wallet_banner",
            "pay_home_card",
            "settings",
            "dashboard_info",
            "disable_sheet",
            "cash_banner",
            "profile",
            "send_invitation",
            "onboarding",
            "swap_fee"
          ]
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false,
  "required": ["event", "properties"]
}
