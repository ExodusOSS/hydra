{
  "name": "@exodus/key-ids",
  "version": "2.1.1",
  "type": "module",
  "description": "This package holds key identifiers for Exodus' own BIP43 purpose",
  "author": "Exodus Movement, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
