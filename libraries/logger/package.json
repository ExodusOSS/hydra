{
  "name": "@exodus/logger",
  "version": "1.2.4",
  "type": "module",
  "description": "A simple logger for all things hydra",
  "author": "Exodus Movement, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/libraries/logger",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Alogger"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./transports/console": "./lib/transports/console.js",
    "./transports/debug": "./lib/transports/debug.js"
  },
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm -w run build --scope @exodus/logger",
    "clean": "pnpm exec tsc --build --clean",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm run lint --fix",
    "test": "pnpm exec exodus-test --jest --esbuild",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "debug": "^4.3.5"
  },
  "publishConfig": {
    "provenance": false
  }
}
