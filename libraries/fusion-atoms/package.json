{
  "name": "@exodus/fusion-atoms",
  "version": "1.4.1",
  "description": "The fusion-atoms library",
  "author": "Exodus Movement, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/libraries/fusion-atoms",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Afusion-atoms"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "clean": "pnpm exec tsc --build --clean",
    "test": "pnpm exec exodus-test --jest --esbuild",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm run lint --fix",
    "prepublishOnly": "pnpm -w run build --scope @exodus/fusion-atoms"
  },
  "devDependencies": {
    "@exodus/atom-tests": "workspace:^",
    "@types/lodash": "^4.14.200"
  },
  "dependencies": {
    "@exodus/atoms": "workspace:^",
    "@exodus/basic-utils": "workspace:^",
    "lodash": "^4.17.21"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
