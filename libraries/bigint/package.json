{
  "name": "@exodus/bigint",
  "version": "4.2.1",
  "description": "bigint wrapper for native BigInt",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "author": "Exodus Movement, Inc.",
  "license": "MIT",
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/libraries/bigint",
  "files": [
    "lib",
    "CHANGELOG.md",
    "README.md"
  ],
  "dependencies": {
    "minimalistic-assert": "^1.0.1"
  },
  "devDependencies": {
    "@types/minimalistic-assert": "^1.0.1"
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "clean": "pnpm exec tsc --build --clean",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm run lint --fix",
    "test": "pnpm exec exodus-test --jest --esbuild",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm -w run build --scope @exodus/bigint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Abigint"
  },
  "publishConfig": {
    "provenance": false
  }
}
