{
  "$schema": "packages/lerna/schemas/lerna-schema.json",
  "version": "independent",
  "npmClient": "pnpm",
  "packages": [
    "libraries/*",
    "tools/packages/*",
    "tools/you-shall-not-pass/*",
    "tools",
    "features/*",
    "adapters/*",
    "sdks/*",
    "apps/*",
    "lint/*",
    "docs",
    "docs/*",
    "ui/*"
  ],
  "changelogPreset": "./changelog.config.js",
  "command": {
    "version": {
      "preid": "rc"
    }
  }
}
