{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "test": {
      "inputs": ["^production", "test"],
      "dependsOn": ["^build", "^prepack"],
      "outputs": ["{projectRoot}/coverage"],
      "cache": true
    },
    "test:integration": {
      "dependsOn": ["^build", "^prepack"],
      "outputs": ["{projectRoot}/coverage"],
      "cache": true
    },
    "build": {
      "dependsOn": ["^build", "^prepack"],
      "inputs": ["default", "^production", "{workspaceRoot}/tools/tsconfig.json"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/lib", "{projectRoot}/build"],
      "cache": true
    },
    "prepack": {
      "dependsOn": ["build"]
    },
    "lint": {
      "inputs": ["^production", "lint"],
      "dependsOn": [],
      "cache": true
    },
    "lint:fix": {
      "cache": true
    },
    "typecheck": {
      "inputs": ["^production", "default"],
      "dependsOn": ["^build", "^prepack"],
      "cache": true
    }
  },
  "workspaceLayout": {
    "appsDir": "modules"
  },
  "namedInputs": {
    "lint": [
      "default",
      "{workspaceRoot}/lint/**",
      "{workspaceRoot}/.eslintrc.js",
      "{workspaceRoot}/.eslintignore",
      "{workspaceRoot}/.prettierignore"
    ],
    "test": ["default", "{workspaceRoot}/jest.config.js", "{workspaceRoot}/jest.setup.js"],
    "default": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{projectRoot}/**/*"
    ],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.js",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.(spec|test).json",
      "!{projectRoot}/jest.(config|setup).[jt]s"
    ]
  },
  "cacheDirectory": ".cache/nx",
  "maxCacheSize": "256MB",
  "parallel": 7
}
