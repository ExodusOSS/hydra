{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": ".",
    "skipLibCheck": true,
    "outDir": "./lib",
    "noEmit": true,
    "allowJs": true,
    "lib": ["esnext"],
    "target": "es2022"
  },
  "include": ["src", "redux"]
}
