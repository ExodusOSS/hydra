{
  "name": "@exodus/balances",
  "version": "13.16.1",
  "description": "Tracks crypto balances across enabled wallet accounts.",
  "author": "Exodus Movement, Inc.",
  "license": "MIT",
  "scripts": {
    "test": "pnpm exec exodus-test --jest",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "lint": "pnpm exec eslint -c ../../eslint.config.mjs",
    "lint:fix": "pnpm run lint --fix",
    "format": "pnpm exec prettier --write \"**/*.{json,md,yaml}\" --log-level warn",
    "format:check": "pnpm exec prettier --check \"**/*.{json,md,yaml}\" --log-level warn"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "module",
    "atoms",
    "default-config.js",
    "index.d.ts",
    "tsconfig.json",
    "report",
    "plugins",
    "redux",
    "README.md",
    "CHANGELOG.md",
    "!**/__tests__/**"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/features/balances",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Abalances"
  },
  "dependencies": {
    "@exodus/asset-types": "^0.6.0",
    "@exodus/atoms": "workspace:^",
    "@exodus/basic-utils": "workspace:^",
    "@exodus/core-selectors": "workspace:^",
    "@exodus/currency": "workspace:^",
    "@exodus/errors": "workspace:^",
    "@exodus/models": "workspace:^",
    "@exodus/multi-account-redux": "workspace:^",
    "@exodus/redux-dependency-injection": "workspace:^",
    "@exodus/safe-string": "workspace:^",
    "@exodus/typeforce": "workspace:^",
    "@exodus/zod": "^3.24.4",
    "lodash": "^4.17.21",
    "make-concurrent": "^4.0.0",
    "reselect": "^3.0.1"
  },
  "peerDependencies": {
    "@exodus/blockchain-metadata": "^17.0.0"
  },
  "devDependencies": {
    "@exodus/assets": "^11.0.0",
    "@exodus/assets-base": "^12.0.0",
    "@exodus/assets-feature": "workspace:^",
    "@exodus/available-assets": "workspace:^",
    "@exodus/bitcoin-meta": "^2.0.0",
    "@exodus/blockchain-metadata": "workspace:^",
    "@exodus/ethereum-meta": "^2.0.0",
    "@exodus/fee-data-monitors": "workspace:^",
    "@exodus/storage-memory": "workspace:^",
    "@exodus/wallet-accounts": "workspace:^",
    "events": "^3.3.0",
    "redux": "^4.2.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
