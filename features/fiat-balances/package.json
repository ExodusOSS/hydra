{
  "name": "@exodus/fiat-balances",
  "version": "13.8.0",
  "description": "Track asset and portfolio fiat balances based on changes in crypto balances and the user's preferred fiat currency",
  "author": "Exodus Movement, Inc.",
  "license": "MIT",
  "scripts": {
    "test": "pnpm exec exodus-test --jest",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "lint": "pnpm exec eslint -c ../../eslint.config.mjs",
    "lint:fix": "pnpm run lint --fix",
    "format": "pnpm exec prettier --write \"**/*.{json,md,yaml}\" --log-level warn",
    "format:check": "pnpm exec prettier --check \"**/*.{json,md,yaml}\" --log-level warn"
  },
  "type": "module",
  "main": "index.js",
  "files": [
    "atoms",
    "module",
    "plugin",
    "redux",
    "report",
    "shared",
    "index.d.ts",
    "CHANGELOG.md",
    "README.md",
    "!**/__tests__/**"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/features/fiat-balances",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Afiat-balances"
  },
  "dependencies": {
    "@exodus/atoms": "workspace:^",
    "@exodus/basic-utils": "workspace:^",
    "@exodus/currency": "workspace:^",
    "@exodus/fiat-currencies": "workspace:^",
    "@exodus/formatting": "workspace:^",
    "lodash": "^4.17.21",
    "reselect": "^3.0.1"
  },
  "devDependencies": {
    "@exodus/assets": "^11.0.0",
    "@exodus/assets-base": "^12.0.0",
    "@exodus/assets-feature": "workspace:^",
    "@exodus/available-assets": "workspace:^",
    "@exodus/balances": "workspace:^",
    "@exodus/blockchain-metadata": "workspace:^",
    "@exodus/combined-assets-meta": "^3.3.2",
    "@exodus/enabled-assets": "workspace:^",
    "@exodus/favorite-assets": "workspace:^",
    "@exodus/fee-data-monitors": "workspace:^",
    "@exodus/models": "workspace:^",
    "@exodus/rates-monitor": "workspace:^",
    "@exodus/redux-dependency-injection": "workspace:^",
    "@exodus/solana-meta": "^2.0.0",
    "@exodus/storage-memory": "workspace:^",
    "@exodus/wallet-accounts": "workspace:^",
    "events": "^3.3.0",
    "minimalistic-assert": "^1.0.1",
    "redux": "^4.2.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
