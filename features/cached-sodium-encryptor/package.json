{
  "name": "@exodus/cached-sodium-encryptor",
  "version": "1.4.4",
  "description": "Derives & caches keys for sodium encryptor for encryption/decryption in features that operate regardless of lock (after initial unlock)",
  "author": "Exodus Movement, Inc.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/features/cached-sodium-encryptor",
  "license": "MIT",
  "keywords": [
    "encryption",
    "sodium",
    "crypto",
    "cache"
  ],
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Acached-sodium-encryptor"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./api": "./lib/api/index.js",
    "./api/*.js": "./lib/api/*.js",
    "./module": "./lib/module/index.js"
  },
  "files": [
    "lib",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "build:watch": "concurrently 'pnpm exec tsc -w -p tsconfig.build.json' 'pnpm exec tsc-alias -w -p tsconfig.build.json'",
    "clean": "pnpm exec tsc --build --clean",
    "lint": "pnpm exec eslint",
    "lint:fix": "pnpm run lint --fix",
    "test": "pnpm exec exodus-test --esbuild",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm -w run build --scope @exodus/cached-sodium-encryptor",
    "sync:mobile": "concurrently 'pnpm -w run sync:mobile -- @exodus/cached-sodium-encryptor' pnpm:build:watch"
  },
  "dependencies": {
    "@exodus/basic-utils": "^5.0.0",
    "@exodus/crypto": "^1.0.0-rc.22",
    "@exodus/key-identifier": "^1.3.1",
    "@exodus/key-ids": "^2.1.0",
    "@exodus/zod": "^3.24.4",
    "make-concurrent": "^5.4.0",
    "minimalistic-assert": "^1.0.1"
  },
  "devDependencies": {
    "@exodus/argo": "workspace:^",
    "@exodus/dependency-types": "workspace:^",
    "@exodus/keychain": "workspace:^",
    "@exodus/logger": "workspace:^",
    "@types/minimalistic-assert": "^1.0.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
