{
  "name": "@exodus/error-tracking",
  "version": "3.6.1",
  "type": "module",
  "description": "A simple error tracking package to let any feature collect errors and create the report",
  "author": "Exodus Movement, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/features/error-tracking",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Aerror-tracking"
  },
  "main": "index.js",
  "exports": "./index.js",
  "files": [
    "api",
    "atoms",
    "module",
    "plugin",
    "report",
    "CHANGELOG.md",
    "README.md",
    "index.d.ts",
    "!**/__tests__/**"
  ],
  "scripts": {
    "test": "pnpm exec exodus-test --jest",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "lint": "pnpm exec eslint -c ../../eslint.config.mjs",
    "lint:fix": "pnpm run lint --fix"
  },
  "dependencies": {
    "@exodus/atoms": "workspace:^",
    "@exodus/basic-utils": "workspace:^",
    "@exodus/errors": "workspace:^",
    "@exodus/safe-string": "workspace:^",
    "@exodus/sentry-client": "workspace:^",
    "@exodus/typeforce": "workspace:^",
    "@exodus/zod": "^3.24.4"
  },
  "devDependencies": {
    "@exodus/traceparent": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
