{
  "name": "@exodus/tx-signer",
  "version": "3.2.2",
  "description": "a module to sign transactions",
  "author": "Exodus Movement, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/features/tx-signer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Atx-signer"
  },
  "main": "lib/index.js",
  "type": "module",
  "files": [
    "lib/",
    "CHANGELOG.md",
    "!**/__tests__/**"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "clean": "pnpm exec tsc --build --clean",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm run lint --fix",
    "test": "pnpm exec exodus-test --jest --esbuild",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm -w run build --scope @exodus/tx-signer"
  },
  "dependencies": {
    "@exodus/asset-lib": "^5.2.1",
    "@exodus/basic-utils": "workspace:^",
    "@exodus/key-identifier": "workspace:^",
    "@exodus/key-utils": "workspace:^",
    "@exodus/models": "workspace:^",
    "minimalistic-assert": "^1.0.1"
  },
  "devDependencies": {
    "@exodus/asset-sources": "workspace:^",
    "@exodus/assets": "^11.0.0",
    "@exodus/atoms": "workspace:^",
    "@exodus/bip39": "workspace:^",
    "@exodus/bitcoin-plugin": "^2.0.0",
    "@exodus/dependency-types": "workspace:^",
    "@exodus/keychain": "workspace:^",
    "@exodus/solana-plugin": "^1.15.0",
    "@types/minimalistic-assert": "^1.0.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "peerDependencies": {
    "@exodus/keychain": ">=9.0.0 <13.0.0"
  }
}
