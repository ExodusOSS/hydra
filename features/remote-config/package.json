{
  "name": "@exodus/remote-config",
  "type": "module",
  "version": "3.5.2",
  "description": "Module to provide unified access remote config",
  "author": "Exodus Movement, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/features/remote-config",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Aremote-config"
  },
  "keywords": [
    "configuration"
  ],
  "files": [
    "lib",
    "redux.js",
    "CHANGELOG.md",
    "README.md"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./redux": "./lib/redux/index.js",
    "./lib/redux": "./lib/redux/index.js"
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "clean": "pnpm exec tsc --build --clean",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm run lint --fix",
    "test": "pnpm exec exodus-test --jest --esbuild",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm -w run build --scope @exodus/remote-config"
  },
  "devDependencies": {
    "@exodus/dependency-types": "workspace:^",
    "@exodus/error-tracking": "workspace:^",
    "@exodus/logger": "workspace:^",
    "@exodus/storage-interface": "workspace:^",
    "@types/lodash": "^4.14.182",
    "@types/ms": "^0.7.31",
    "redux": "^4.2.1"
  },
  "dependencies": {
    "@exodus/atoms": "workspace:^",
    "@exodus/basic-utils": "workspace:^",
    "@exodus/redux-dependency-injection": "workspace:^",
    "@exodus/safe-string": "workspace:^",
    "@exodus/typeforce": "workspace:^",
    "@exodus/zod": "^3.24.4",
    "delay": "^5.0.0",
    "lodash": "^4.17.21",
    "ms": "^0.7.1",
    "reselect": "^3.0.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
