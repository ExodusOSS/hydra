{
  "name": "@exodus/application",
  "version": "4.0.1",
  "type": "module",
  "description": "Feature that manages the Exodus SDK application lifecycle.",
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/features/application",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Aapplication"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./redux": "./lib/redux/index.js"
  },
  "author": "Exodus Movement, Inc.",
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "clean": "pnpm exec tsc --build --clean",
    "lint": "pnpm exec eslint .",
    "test": "pnpm exec exodus-test --jest --esbuild",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "lint:fix": "pnpm run lint --fix",
    "prepublishOnly": "pnpm -w run build --scope @exodus/application"
  },
  "files": [
    "lib",
    "redux.js",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@exodus/atoms": "workspace:^",
    "@exodus/basic-utils": "workspace:^",
    "@exodus/fusion-atoms": "workspace:^",
    "@exodus/logger": "workspace:^",
    "@exodus/proxy-freeze": "workspace:^",
    "@exodus/redux-dependency-injection": "workspace:^",
    "@exodus/storage-interface": "workspace:^",
    "@exodus/wild-emitter": "workspace:^",
    "@exodus/zod": "^3.24.4",
    "events": "^3.3.0",
    "minimalistic-assert": "^1.0.1",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "@exodus/dependency-types": "workspace:^",
    "@types/jest": "^29.5.11",
    "@types/minimalistic-assert": "^1.0.2",
    "@types/ms": "^2.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
