{
  "name": "@exodus/locale",
  "version": "2.7.1",
  "description": "Module for tracking users locale data such as language and currency",
  "author": "Exodus Movement, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/features/locale",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Alocale"
  },
  "type": "module",
  "main": "index.js",
  "files": [
    "api",
    "atoms",
    "plugin",
    "redux",
    "migrations",
    "index.d.ts",
    "CHANGELOG.md",
    "README.md",
    "!**/__tests__/**"
  ],
  "scripts": {
    "test": "pnpm exec exodus-test --jest",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "lint": "pnpm exec eslint",
    "lint:fix": "pnpm run lint --fix",
    "test:types": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@exodus/atoms": "workspace:^",
    "@exodus/currency": "workspace:^",
    "@exodus/fiat-currencies": "workspace:^",
    "@exodus/fusion-atoms": "workspace:^"
  },
  "devDependencies": {
    "@exodus/redux-dependency-injection": "workspace:^",
    "redux": "4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
