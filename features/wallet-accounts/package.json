{
  "name": "@exodus/wallet-accounts",
  "version": "20.4.12",
  "description": "CRUD interface for managing wallet accounts, a.k.a. portfolios.",
  "author": "Exodus Movement, Inc.",
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/features/wallet-accounts",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./redux": "./lib/redux/index.js",
    "./redux/index.js": "./lib/redux/index.js",
    "./redux/*": "./lib/redux/*",
    "./atoms/*": "./lib/atoms/*",
    "./migrations/*": "./lib/migrations/*"
  },
  "files": [
    "lib/",
    "redux.js",
    "migrations/",
    "CHANGELOG.md",
    "!**/__tests__/**"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "build:watch": "pnpm exec tsc -p tsconfig.build.json --watch",
    "clean": "pnpm exec tsc --build --clean",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm run lint --fix",
    "test": "pnpm exec exodus-test --jest --esbuild",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm -w run build --scope @exodus/wallet-accounts"
  },
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Awallet-accounts"
  },
  "dependencies": {
    "@exodus/atoms": "workspace:^",
    "@exodus/basic-utils": "workspace:^",
    "@exodus/core-selectors": "workspace:^",
    "@exodus/dependency-types": "workspace:^",
    "@exodus/fusion-atoms": "workspace:^",
    "@exodus/logger": "workspace:^",
    "@exodus/models": "workspace:^",
    "@exodus/proxy-freeze": "workspace:^",
    "@exodus/redux-dependency-injection": "workspace:^",
    "@exodus/safe-string": "workspace:^",
    "@exodus/storage-interface": "workspace:^",
    "@exodus/typeforce": "workspace:^",
    "@exodus/zod": "^3.24.4",
    "lodash": "^4.17.21",
    "make-concurrent": "^5.3.0",
    "minimalistic-assert": "^1.0.1",
    "p-defer": "^4.0.0",
    "reselect": "^3.0.1"
  },
  "devDependencies": {
    "@exodus/argo": "workspace:^",
    "@exodus/dependency-injection": "workspace:^",
    "@exodus/fusion-local": "workspace:^",
    "@exodus/storage-memory": "workspace:^",
    "@types/lodash": "^4.17.0",
    "@types/minimalistic-assert": "^1.0.1",
    "@types/jest-when": "^3.5.5",
    "jest-when": "^3.5.2",
    "redux": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
