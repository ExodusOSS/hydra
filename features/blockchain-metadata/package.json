    "@exodus/proxy-freeze": "workspace:^",
    "@exodus/redux-dependency-injection": "workspace:^",
    "@exodus/safe-string": "workspace:^",
    "@exodus/zod": "^3.24.4",
    "events": "^3.3.0",
