{
  "name": "@exodus/blockchain-metadata",
  "version": "17.2.2",
  "author": "Exodus Movement, Inc.",
  "description": "Manages access to and persistence of blockchain metadata, specifically transaction history and account state.",
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/features/blockchain-metadata",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./atoms/index.js": "./lib/atoms/index.js",
    "./module/index.js": "./lib/module/index.js",
    "./redux/account-states": "./lib/redux/account-states/index.js",
    "./redux/account-states/index.js": "./lib/redux/account-states/index.js",
    "./redux/tx-logs": "./lib/redux/tx-logs/index.js",
    "./redux/tx-logs/index.js": "./lib/redux/tx-logs/index.js"
  },
  "files": [
    "lib/",
    "atoms/index.d.ts",
    "module/index.d.ts",
    "redux/account-states/index.d.ts",
    "redux/tx-logs/index.d.ts",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "clean": "pnpm exec tsc --build --clean",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm run lint --fix",
    "test": "pnpm exec exodus-test --jest --esbuild",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm -w run build --scope @exodus/blockchain-metadata"
  },
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Ablockchain-metadata"
