    "@exodus/monero-meta": "^2.0.0",
    "@exodus/storage-memory": "workspace:^",
    "@exodus/wallet-accounts": "workspace:^",
    "@types/jest": "^29.5.11",
    "@types/jest-when": "^3.5.2",
    "@types/lodash": "^4.17.0",
    "@types/ms": "^2",
    "jest-when": "^3.5.2",
