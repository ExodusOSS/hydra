  "license": "MIT",
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "build:watch": "pnpm exec tsc -w -p tsconfig.build.json",
    "clean": "pnpm exec tsc --build --clean",
    "lint": "pnpm exec eslint -c ../../eslint.config.mjs",
    "lint:fix": "pnpm run lint --fix",
    "test": "pnpm exec exodus-test --jest --esbuild",
    "prepublishOnly": "pnpm -w run build --scope @exodus/market-history"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./redux": "./lib/redux/index.js"
  },
  "files": [
    "lib",
    "redux.js",
    "CHANGELOG.md",
    "README.md"
  ],
  "dependencies": {
    "@exodus/atoms": "^10.3.3",
    "@exodus/basic-utils": "^5.0.0",
    "@exodus/dayjs": "^1.0.2",
    "@exodus/remote-config": "^3.5.1",
    "@exodus/remote-config-atoms": "^1.1.0",
    "@exodus/safe-string": "^1.3.0",
    "delay": "^5.0.0",
    "make-concurrent": "^5.4.0",
    "ms": "^0.7.1",
    "reselect": "^3.0.1"
  },
  "devDependencies": {
    "@exodus/assets": "^11.0.0",
    "@exodus/assets-base": "^12.0.0",
    "@exodus/assets-feature": "workspace:^",
    "@exodus/bitcoin-meta": "^2.0.0",
    "@exodus/dependency-types": "workspace:^",
    "@exodus/ethereum-meta": "^2.4.1",
    "@exodus/locale": "workspace:^",
    "@exodus/logger": "workspace:^",
    "@exodus/rates-monitor": "workspace:^",
    "@exodus/redux-dependency-injection": "workspace:^",
    "@exodus/storage-memory": "workspace:^",
    "@exodus/synchronized-time": "workspace:^",
    "@types/ms": "^2.1.0",
    "events": "^3.3.0",
    "redux": "^4.0.0"
  },
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/features/market-history",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Amarket-history"
