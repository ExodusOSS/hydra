{
  "name": "@exodus/rates-monitor",
  "version": "4.16.0",
  "license": "MIT",
  "author": "Exodus Movement, Inc.",
  "description": "Fetches asset prices in fiat on a timer",
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/features/rates-monitor",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Arates-monitor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "clean": "pnpm exec tsc --build --clean",
    "test": "pnpm exec exodus-test --jest --esbuild",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm run lint --fix",
    "prepublishOnly": "pnpm -w run build --scope @exodus/rates-monitor"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./redux": "./lib/redux/index.js",
    "./redux/index.js": "./lib/redux/index.js"
  },
  "files": [
    "lib",
    "redux.js",
    "CHANGELOG.md",
    "README.md",
    "!**/__tests__/**"
  ],
  "dependencies": {
    "@exodus/atoms": "workspace:^",
    "@exodus/basic-utils": "workspace:^",
    "@exodus/logger": "workspace:^",
    "@exodus/redux-dependency-injection": "workspace:^",
    "@exodus/storage-interface": "workspace:^",
    "lodash": "^4.17.21",
    "make-concurrent": "^5.4.0",
    "minimalistic-assert": "^1.0.1",
    "ms": "^0.7.1",
    "reselect": "^3.0.1"
  },
  "devDependencies": {
    "@exodus/assets-feature": "workspace:^",
    "@exodus/assets-test-meta": "workspace:^",
    "@exodus/dependency-types": "workspace:^",
    "@exodus/locale": "workspace:^",
    "@types/lodash": "^4.17.0",
    "@types/minimalistic-assert": "^1.0.1",
    "@types/ms": "^0.7.34",
    "redux": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
