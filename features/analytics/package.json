{
  "name": "@exodus/analytics",
  "version": "16.1.2",
  "description": "This Exodus SDK feature enables you to generate client-side analytics.",
  "author": "Exodus Movement, Inc.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./atoms": "./lib/atoms/index.js",
    "./module": "./lib/module/index.js",
    "./migrations/opt-in-migration": "./lib/migrations/opt-in-migration.js",
    "./redux": "./lib/redux/index.js",
    "./redux/index.js": "./lib/redux/index.js"
  },
  "files": [
    "lib",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "clean": "rm -rf lib",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "pnpm exec exodus-test --jest --esbuild",
    "lint": "pnpm exec eslint",
    "lint:fix": "pnpm run lint --fix",
    "prepublishOnly": "pnpm -w run build --scope @exodus/analytics"
  },
  "dependencies": {
    "@exodus/analytics-validation": "workspace:^",
    "@exodus/atoms": "workspace:^",
    "@exodus/basic-utils": "workspace:^",
    "@exodus/crypto": "^1.0.0-rc.2",
    "@exodus/fetch": "^1.3.0",
    "@exodus/fusion-atoms": "workspace:^",
    "@exodus/key-identifier": "workspace:^",
    "@exodus/key-ids": "workspace:^",
    "@exodus/segment-metrics": "workspace:^",
    "@exodus/storage-interface": "workspace:^",
    "@exodus/typeforce": "workspace:^",
    "@exodus/zod": "^3.24.4",
    "lodash": "^4.17.21",
    "p-defer": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/features/analytics",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Aanalytics"
  },
  "devDependencies": {
    "@exodus/argo": "workspace:^",
    "@exodus/bip32": "workspace:^",
    "@exodus/bip39": "workspace:^",
    "@exodus/dependency-types": "workspace:^",
    "@exodus/keychain": "workspace:^",
    "@exodus/logger": "workspace:^",
    "@exodus/redux-dependency-injection": "workspace:^",
    "@exodus/storage-memory": "workspace:^",
    "@types/lodash": "^4.14.182",
    "jest-mock": "^30.3.0",
    "redux": "^4.2.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
