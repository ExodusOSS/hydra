{
  "name": "@exodus/tx-log-monitors",
  "version": "3.0.5",
  "description": "This Exodus SDK feature loads transaction history for all enabled assets. It also provides the option to force refresh transaction history for assets individually or en masse.",
  "author": "Exodus Movement, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/features/tx-log-monitors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Atx-log-monitors"
  },
  "type": "module",
  "main": "index.js",
  "files": [
    "module",
    "atoms",
    "api",
    "plugin",
    "redux",
    "report",
    "README.md",
    "CHANGELOG.md",
    "index.d.ts",
    "!**/__tests__/**",
    "!**/*.test.js"
  ],
  "scripts": {
    "lint": "pnpm exec eslint -c ../../eslint.config.mjs",
    "lint:fix": "pnpm run lint --fix",
    "test": "pnpm exec exodus-test --jest",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@exodus/asset-lib": "^5.2.1",
    "@exodus/assets": "^11.0.0",
    "@exodus/atoms": "workspace:^",
    "@exodus/basic-utils": "workspace:^",
    "@exodus/remote-config-atoms": "workspace:^",
    "@exodus/zod": "^3.24.4",
    "events": "^3.3.0",
    "lodash": "^4.17.21",
    "make-concurrent": "^5.4.0"
  },
  "devDependencies": {
    "@exodus/assets-test-meta": "workspace:^",
    "@exodus/available-assets": "workspace:^",
    "@exodus/enabled-assets": "workspace:^",
    "@exodus/storage-memory": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
