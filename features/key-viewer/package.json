{
  "name": "@exodus/key-viewer",
  "version": "1.1.7",
  "description": "Export an asset's encoded private key for software wallet accounts",
  "author": "Exodus Movement, Inc.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExodusMovement/exodus.git"
  },
  "homepage": "https://github.com/ExodusMovement/exodus/tree/master/libs/features/key-viewer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ExodusMovement/exodus/issues?q=is%3Aissue+is%3Aopen+label%3Akey-viewer"
  },
  "main": "lib/index.js",
  "files": [
    "lib",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "build:watch": "concurrently 'pnpm exec tsc -w -p tsconfig.build.json' 'pnpm exec tsc-alias -w -p tsconfig.build.json'",
    "clean": "pnpm exec tsc --build --clean",
    "lint": "pnpm exec eslint -c ../../eslint.config.mjs",
    "lint:fix": "pnpm run lint --fix",
    "test": "pnpm exec exodus-test --jest --esbuild",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm -w run build --scope @exodus/key-viewer",
    "sync:mobile": "concurrently 'pnpm -w run sync:mobile -- @exodus/key-viewer' pnpm:build:watch"
  },
  "devDependencies": {
    "@exodus/address-provider": "workspace:^",
    "@exodus/asset-sources": "workspace:^",
    "@exodus/atoms": "workspace:^",
    "@exodus/bip39": "workspace:^",
    "@exodus/bitcoin-plugin": "^2.0.0",
    "@exodus/dependency-types": "workspace:^",
    "@exodus/key-utils": "workspace:^",
    "@exodus/keychain": "workspace:^",
    "@exodus/logger": "workspace:^",
    "@exodus/models": "workspace:^",
    "@exodus/public-key-provider": "workspace:^",
    "@types/minimalistic-assert": "^1.0.1"
  },
  "dependencies": {
    "@exodus/asset-lib": "^5.2.1",
    "@exodus/key-identifier": "workspace:^",
    "minimalistic-assert": "^1.0.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
