{
  "compilerOptions": {
    "baseUrl": "./",
    "target": "es2022",
    "moduleResolution": "node",
    "declaration": true,
    "useDefineForClassFields": true,
    "removeComments": true,
    "skipLibCheck": true,
    "strict": true,
    "downlevelIteration": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true
  },
  "exclude": ["node_modules"]
}
